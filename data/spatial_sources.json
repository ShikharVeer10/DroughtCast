{
  "purpose": "Public-source manifest for reproducible spatial evidence. Downloads are intentionally not bundled.",
  "boundaries": {
    "provider": "GADM",
    "version": "4.1",
    "url": "https://geodata.ucdavis.edu/gadm/gadm4.1/gadm_410-gpkg.zip",
    "license_url": "https://gadm.org/license.html"
  },
  "elevation": {
    "provider": "Copernicus DEM GLO-30",
    "product_url": "https://dataspace.copernicus.eu/explore-data/data-collections/copernicus-contributing-missions/collections-description/COP-DEM",
    "aws_catalog": "https://copernicus-dem-30m.s3.amazonaws.com/readme.html",
    "resolution_m": 30
  },
  "observed_drought": {
    "provider": "SPEIbase",
    "provider_url": "https://spei.csic.es/database.html",
    "resolution_degrees": 0.5,
    "required_scales": ["spei_3", "spei_6", "spei_12"]
  },
  "required_local_product": {
    "format": "NetCDF",
    "coordinates": ["time", "lat", "lon"],
    "variables": [
      "obs_spei_3", "obs_spei_6", "obs_spei_12",
      "pred_spei_3", "pred_spei_6", "pred_spei_12"
    ],
    "note": "Predictions must be generated by the model on the same grid; point-site interpolation is prohibited."
  }
}
